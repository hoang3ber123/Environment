<odoo>
    <!-- Form thêm, sửa Service -->
    <record id="view_service_form" model="ir.ui.view">
        <field name="name">env.service.form</field>
        <field name="model">env.service</field>
        <field name="arch" type="xml">
            <form string="Service">
                <sheet>
                    <notebook>
                        <!-- Tab Thông tin dịch vụ -->
                        <page string="Thông tin dịch vụ">
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="description"/>
                                </group>
                                <group>
                                    <field name="status"/>
                                    <field name="scope"/>
                                    <field name="groupservice_id" options="{'no_create': True}"/>
                                </group>
                            </group>
                        </page>

                        <!-- Tab Bảng giá -->
                        <page string="Bảng giá liên quan">
                            <field name="serviceprice_ids">
                                <list>
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="customerwastegroup_id"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="status"/>
                                </list>
                                <form string="Bảng giá dịch vụ">
                                    <sheet>
                                        <notebook>
                                            <!-- Tab Thông tin bảng giá -->
                                            <page string="Thông tin bảng giá">
                                                <group>
                                                    <group>
                                                        <field name="name"/>
                                                        <field name="code"/>
                                                        <field name="customerwastegroup_id"/>
                                                    </group>
                                                    <group>
                                                        <field name="effective_from"/>
                                                        <field name="effective_to"/>
                                                        <field name="status"/>
                                                    </group>
                                                </group>
                                            </page>

                                            <!-- Tab Thành phần giá -->
                                            <page string="Thành phần giá">
                                                <field name="component_ids">
                                                    <list>
                                                        <field name="name"/>
                                                        <field name="component_name"/>
                                                        <field name="amount"/>
                                                        <field name="unit"/>
                                                        <field name="description"/>
                                                    </list>
                                                    <form string="Chi tiết thành phần giá">
                                                        <group>
                                                            <field name="name"/>
                                                            <field name="component_name"/>
                                                            <field name="amount"/>
                                                            <field name="unit"/>
                                                            <field name="description"/>
                                                        </group>
                                                    </form>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view Service -->
    <record id="view_service_list" model="ir.ui.view">
        <field name="name">env.service.list</field>
        <field name="model">env.service</field>
        <field name="arch" type="xml">
            <list string="Service">
                <field name="name"/>
                <field name="code"/>
                <field name="status"/>
                <field name="groupservice_id"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_service" model="ir.actions.act_window">
        <field name="name">Dịch vụ</field>
        <field name="res_model">env.service</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Quản lý dịch vụ và bảng giá</p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_service" name="Dịch vụ" parent="menu_service_root" action="action_service"/>
</odoo>
