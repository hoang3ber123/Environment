<odoo>
    <!-- Form View -->
    <record id="view_collectionunit_form" model="ir.ui.view">
        <field name="name">env.collectionunit.form</field>
        <field name="model">env.collectionunit</field>
        <field name="arch" type="xml">
            <form string="Đơn vị thu gom">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="manager_id"/>
                            <field name="phone"/>
                            <field name="email"/>
                        </group>
                        <group>
                            <field name="location_ids" widget="many2many_tags"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group>
                        <field name="description"/>
                    </group>
                    <notebook>
                        <!-- Tab dịch vụ liên kết -->
                        <page string="Dịch vụ liên kết">
                            <field name="service_rel_ids">
                                <list editable="bottom">
                                    <field name="service_id"/>
                                    <field name="status"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="service_id"/>
                                            <field name="status"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <!-- Tab bảng giá liên kết -->
                        <page string="Bảng giá liên kết">
                            <field name="unitserviceprice_ids">
                                <list editable="bottom">
                                    <field name="service_price_id"/>
                                    <field name="multiplier"/>
                                    <field name="effective_from"/>
                                    <field name="effective_to"/>
                                    <field name="status"/>
                                </list>
                                <form>
                                    <sheet>
                                        <group>
                                            <field name="service_price_id"/>
                                            <field name="multiplier"/>
                                            <field name="effective_from"/>
                                            <field name="effective_to"/>
                                            <field name="status"/>
                                        </group>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                        <!-- Tab nhóm nhân viên -->
                        <page string="Nhóm nhân viên">
                            <field name="collection_group_ids">
                                <list string="Nhóm nhân viên">
                                    <field name="name"/>
                                </list>
                                <form string="Nhóm nhân viên">
                                    <sheet>
                                        <notebook>
                                            <!-- Tab nhóm nhân viên -->
                                            <page string="nhóm thành viên">
                                                <group>
                                                    <field name="name"/>
                                                    <field name="collection_unit_id" readonly="1"/>
                                                </group>
                                            </page>
                                            <!-- Tab Thành viên -->
                                            <page string="Thành viên">
                                                <field name="member_ids">
                                                    <list editable="bottom">
                                                        <field name="name"/>
                                                        <field name="phone"/>
                                                        <field name="email"/>
                                                    </list>
                                                    <form>
                                                        <sheet>
                                                            <group>
                                                                <field name="name"/>
                                                                <field name="phone"/>
                                                                <field name="email"/>
                                                            </group>
                                                        </sheet>
                                                    </form>
                                                </field>
                                            </page>

                                            <!-- Tab Quyền hạn -->
                                            <page string="Quyền hạn">
                                                <field name="action_ids">
                                                    <list editable="bottom">
                                                        <field name="name"/>
                                                        <field name="code"/>
                                                    </list>
                                                    <form>
                                                        <sheet>
                                                            <group>
                                                                <field name="name"/>
                                                                <field name="code"/>
                                                            </group>
                                                        </sheet>
                                                    </form>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <!-- List View -->
    <record id="view_collectionunit_list" model="ir.ui.view">
        <field name="name">env.collectionunit.list</field>
        <field name="model">env.collectionunit</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="manager_id"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="location_ids" widget="many2many_tags"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Action -->
    <record id="action_collectionunit" model="ir.actions.act_window">
        <field name="name">Đơn vị thu gom</field>
        <field name="res_model">env.collectionunit</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Quản lý thông tin các đơn vị thu gom và khu vực phụ trách.</p>
        </field>
    </record>

    <!-- Menu -->
    <menuitem id="menu_collectionunit" name="Đơn vị thu gom"
              parent="menu_unit_root" action="action_collectionunit"/>
</odoo>