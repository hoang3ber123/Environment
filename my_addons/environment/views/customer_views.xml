<odoo>
    <record id="view_customer_form" model="ir.ui.view">
        <field name="name">env.customer.form</field>
        <field name="model">env.customer</field>
        <field name="arch" type="xml">
            <form string="Customer">
                <sheet>
                    <notebook>
                        <!-- Tab Thông tin khách hàng -->
                        <page string="Thông tin khách hàng">
                            <group string="Thông tin cơ bản">
                                <field name="name"/>
                                <field name="customer_type"/>
                                <field name="house_type"/>
                                <field name="waste_classification"/>
                                <field name="phone"/>
                                <field name="email"/>
                                <field name="cccd"/>
                            </group>
                            <group string="Thông tin địa chỉ">
                                <field name="house_number"/>
                                <field name="street"/>
                                <field name="location_id" options="{'no_create': True}"/>
                                <field name="full_path" readonly="1"/>
                                <field name="description"/>
                            </group>
                            <group string="Đơn vị thu gom quản lý">
                                <field name="collection_unit_id" options="{'no_create': True}"/>
                            </group>
                        </page>

                        <!-- Tab Hợp đồng -->
                        <page string="Hợp đồng">
                            <field name="contract_ids">
                                <list string="Hợp đồng">
                                    <field name="contract_number"/>
                                    <field name="service_id"/>
                                    <field name="status"/>
                                    <field name="start_date"/>
                                    <field name="end_date"/>
                                    <field name="monthly_amount"/>
                                    <field name="remaining_debt"/>
                                    <field name="months_paid_count"/>
                                </list>
                                <form string="Hợp đồng">
                                    <sheet>
                                        <notebook>
                                            <!-- Tab Thông tin hợp đồng -->
                                            <page string="Thông tin hợp đồng">
                                                <group>
                                                    <field name="contract_number"/>
                                                    <field name="collection_unit_id" readonly="1"/>
                                                    <field name="service_id"/>
                                                    <field name="customer_waste_group_id"/>
                                                    <field name="estimated_waste_volume"/>
                                                    <field name="status"/>
                                                    <field name="start_date"/>
                                                    <field name="contract_term"/>
                                                    <field name="end_date" readonly="1"/>
                                                    <field name="monthly_amount"/>
                                                </group>
                                            </page>

                                            <!-- Tab Hóa đơn -->
                                            <page string="Hóa đơn thanh toán">
                                                <field name="orders">
                                                    <list>
                                                        <field name="months_selected" widget="many2many_tags"/>
                                                        <field name="total_amount" readonly="1"/>
                                                        <field name="create_date"/>
                                                    </list>
                                                    <form>
                                                        <group>
                                                            <field name="months_selected" widget="many2many_tags"/>
                                                            <field name="total_amount" readonly="1"/>
                                                        </group>
                                                    </form>
                                                </field>
                                            </page>
                                        </notebook>
                                    </sheet>
                                </form>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_customer_list" model="ir.ui.view">
        <field name="name">env.customer.list</field>
        <field name="model">env.customer</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="customer_type"/>
                <field name="house_type"/>
                <field name="waste_classification"/>
                <field name="phone"/>
                <field name="email"/>
                <field name="location_id"/>
                <field name="full_path"/>
            </list>
        </field>
    </record>

    <record id="action_customer" model="ir.actions.act_window">
        <field name="name">Khách hàng</field>
        <field name="res_model">env.customer</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Quản lý thông tin khách hàng</p>
        </field>
    </record>

    <menuitem id="menu_customer" name="Khách hàng" parent="menu_customer_root" action="action_customer"/>
</odoo>
